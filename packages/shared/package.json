{
  "name": "@futuremode/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types and constants between web, api, and ai-bot",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "source": "./src/types/index.ts",
      "default": "./dist/types/index.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "source": "./src/constants.ts",
      "default": "./dist/constants.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "echo 'lint:shared'",
    "typecheck": "tsc --noEmit",
    "test": "echo 'test:shared'"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
