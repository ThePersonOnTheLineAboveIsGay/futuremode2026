# =========================================
# LiveKit (SFU)
# =========================================
# Dev keys only. Generate new keys for production.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret-must-be-at-least-32-characters-long-for-jwt

# Internal URL — API server / AI bot 用，連到 LiveKit SFU
LIVEKIT_URL=ws://localhost:7880

# 公開 URL — 給瀏覽器 client 連線用的 URL。
# 同機測試：保持 ws://localhost:7880
# LAN 測試：改成 ws://192.168.x.x:7880（你的機器 IP）
# 對外部署：改成 wss://meet.example.com
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# =========================================
# OpenAI (LLM + TTS) — 自訂 endpoint 也支援
# =========================================
# OPENAI_API_URL 留空 → 用 OpenAI 官方（https://api.openai.com/v1）
# 填自訂 URL → 用其他 OpenAI 相容服務（如 LiteLLM、Azure OpenAI、MiniMax 等）
OPENAI_API_URL=
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=onyx

# =========================================
# STT (separate endpoint, OpenAI-compatible Whisper API)
# =========================================
# 用自架或第三方 Whisper endpoint（相容 OpenAI /audio/transcriptions 格式）
# 例如：自架 faster-whisper-server、本地 whisper.cpp server、Azure OpenAI、OpenRouter 等
STT_API_URL=https://your-stt-endpoint.example.com/v1
STT_API_KEY=sk-your-stt-key-here
STT_MODEL=whisper-1

# =========================================
# AI Bot
# =========================================
AI_BOT_IDENTITY_PREFIX=ai-bot
CONFIDENCE_THRESHOLD=0.6
COOLDOWN_MS=10000
UTTERANCE_SILENCE_MS=700


BARGE_IN_THRESHOLD_MS=1000

# =========================================
# Apps
# =========================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
API_PORT=3001
WEB_PORT=3000

# =========================================
# Database (Phase 4+)
# =========================================
DATABASE_URL=file:./apps/api/data/dev.db
RECORDINGS_DIR=./apps/api/data/recordings
RECORDING_TTL_DAYS=7

# =========================================
# Logging
# =========================================
LOG_LEVEL=info
NODE_ENV=development
