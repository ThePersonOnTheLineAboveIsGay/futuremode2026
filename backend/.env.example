# 複製成 .env 並填入實際金鑰
GEMINI_API_KEY=...
# 轉錄用，https://openrouter.ai/settings/keys 申請
OPENROUTER_API_KEY=...

# 可選：覆寫預設值
GEMINI_MODEL=gemini-3.6-flash
OPENROUTER_MODEL=openai/whisper-large-v3
ANALYSIS_LANGUAGE=zh-TW

# analyzer 觸發與過濾
ANALYZE_MIN_NEW_SEGMENTS=3
ANALYZE_MIN_INTERVAL_SECONDS=30
ANALYZE_WINDOW_CHARS=4000
CONFIDENCE_THRESHOLD=0.6

# CORS（擴充功能不受 CORS 限制，這裡給本機測試頁用）
ALLOW_ORIGINS=*
