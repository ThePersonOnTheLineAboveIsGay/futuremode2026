{
  "name": "@futuremode/api",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify backend for room management, token signing, and recordings",
  "type": "module",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
